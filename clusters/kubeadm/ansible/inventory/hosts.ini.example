# kubeadm 클러스터 인벤토리 — 실제 값은 hosts.ini 로 복사해서 채운다.
#
#   cp inventory/hosts.ini.example inventory/hosts.ini
#   multipass list    # IP 확인
#
# hosts.ini 는 .gitignore 대상이 아니다. IP는 환경마다 달라지므로 커밋하지 않는 편이 좋다면
# 이 파일을 참고해 직접 제외 규칙을 추가한다.

[control_plane]
cp1 ansible_host=192.168.64.5

[workers]
node1 ansible_host=192.168.64.6
node2 ansible_host=192.168.64.7

[k8s_nodes:children]
control_plane
workers

[k8s_nodes:vars]
ansible_user=ubuntu
ansible_python_interpreter=/usr/bin/python3
# 최초 접속 시 known_hosts 검사 때문에 막히지 않도록 ansible.cfg 에서 끄고 있다

[all:vars]
# 설치 버전은 여기서 한 번만 정한다. 스크립트들은 이 값을 넘겨받아 실행된다.
k8s_minor=v1.37
